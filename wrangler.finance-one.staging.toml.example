# EXAMPLE ONLY — copy to a private staging Wrangler config and fill in real values.
# Do not point this binding to a production D1 database.
# Do not deploy without first running all staging D1 migrations and tests.
name = "neo-finance-one-staging"
main = "worker/finance-one/staging-entry.mjs"
compatibility_date = "2026-10-09"
workers_dev = true

[vars]
FINANCE_ONE_ENVIRONMENT = "staging"
# Keep OFF until migrations + independent credentials + rate limits + review are complete.
FINANCE_ONE_READ_API_ENABLED = "false"
# Requires migration 11 and two separate authorized Finance reviewers.
FINANCE_ONE_OPERATIONS_ENABLED = "false"
# Requires migration 12 and validated original sources; never certifies evidence.
FINANCE_ONE_SOURCE_OPERATIONS_ENABLED = "false"
# Optional separate school source binding. Keep OFF until isolated source QA.
# See docs/FINANCE_ONE_V1_SEPARATE_SCHOOL_SOURCE.md. No migration required.
FINANCE_ONE_SEPARATE_SOURCE_ENABLED = "false"
# FINANCE_ONE_SOURCE_ENVIRONMENT = "staging"
# Optional CPU-light Access login; requires verified application AUD and explicit
# one-person/one-Finance-account subject mapping. Existing Finance memberships apply.
# See docs/FINANCE_ONE_V1_ACCESS_LOGIN.md. No new database migration required.
FINANCE_ONE_ACCESS_LOGIN_ENABLED = "false"
# FINANCE_ONE_ACCESS_ISSUER = "https://YOUR-TEAM.cloudflareaccess.com"
# FINANCE_ONE_ACCESS_AUDIENCE = "REPLACE_WITH_APPLICATION_64_HEX_AUD"
# FINANCE_ONE_ACCESS_IDENTITIES = '[{"subject":"VERIFIED_ACCESS_USER_SUB","accountId":"fin:authorized-user"}]'
# Optional alternate HTTPS portal origin. The same-origin portal is served at /portal.html.
# Replace this illustrative value with an approved HTTPS hostname before enabling Finance.
FINANCE_ONE_PORTAL_ORIGIN = "https://finance-staging.example.com"

[[d1_databases]]
binding = "DB"
database_name = "neo-finance-one-staging"
database_id = "REPLACE_WITH_SEPARATE_STAGING_D1_UUID"

# Optional: NEW isolated school SOURCE staging database, never neo-lead-crm live
# and never a Finance database. The application exposes SELECT reads only.
# [[d1_databases]]
# binding = "SCHOOL_SOURCE_DB"
# database_name = "neo-finance-school-source-qa"
# database_id = "REPLACE_WITH_NEW_ISOLATED_SCHOOL_SOURCE_STAGING_UUID"

# FINANCE_ONE_SESSION_SECRET MUST be set with Wrangler secret management;
# never put it in [vars], source code, or version control.

# Cloudflare assets must run the Worker FIRST for every request; otherwise
# portal.html could bypass FINANCE_ONE_READ_API_ENABLED=false and security headers.
[assets]
directory = "./finance-one"
binding = "ASSETS"
run_worker_first = true
not_found_handling = "none"


# REQUIRED before enabling Finance login. Choose namespace IDs that are unique
# within YOUR Cloudflare account. IDs below are examples, not assigned resources.
# These native counters are per Cloudflare location, not a global WAF.
[[ratelimits]]
name = "FINANCE_ONE_LOGIN_CLIENT_LIMIT"
namespace_id = "9122001"
simple = { limit = 20, period = 60 }

[[ratelimits]]
name = "FINANCE_ONE_LOGIN_ACCOUNT_LIMIT"
namespace_id = "9122002"
simple = { limit = 8, period = 60 }
